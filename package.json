{
  "private": true,
  "name": "@magda/preview-map",
  "version": "1.1.2",
  "description": "Magda geospatial preview based on TerriaMap.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">= 22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/magda-io/magda-preview-map"
  },
  "dependencies": {
    "json5": "^2.1.0",
    "terriajs-server": "5.0.0"
  },
  "resolutions": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-react": "^7.28.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@swc/core": "1.15.46",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "babel-loader": "^10.1.1",
    "babel-plugin-styled-components": "^2.1.4",
    "css-loader": "^7.1.4",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fetch-mock": "^11.1.5",
    "fork-ts-checker-notifier-webpack-plugin": "^9.0.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "fs-extra": "^7.0.1",
    "globals": "^17.4.0",
    "gulp": "^5.0.1",
    "html-webpack-plugin": "^5.6.3",
    "husky": "^9.1.7",
    "is-subdir": "^1.2.0",
    "lodash": "^4.17.21",
    "minimist": "^1.2.8",
    "msw": "^2.12.14",
    "node-notifier": "^10.0.1",
    "plugin-error": "^2.0.1",
    "prettier": "3.8.1",
    "pretty-quick": "^4.2.2",
    "prop-types": "^15.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resolve-url-loader": "^5.0.0",
    "sass": "^1.98.0",
    "sass-loader": "^16.0.7",
    "style-loader": "^4.0.0",
    "svg-sprite": "^2.0.4",
    "terriajs": "8.13.0",
    "terriajs-cesium": "26.0.0",
    "terriajs-plugin-api": "0.0.1-alpha.17",
    "terriajs-plugin-sample": "0.0.1-alpha.7",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.58.1",
    "urijs": "^1.18.12",
    "webpack": "^5.105.4",
    "webpack-cli": "^5.1.4",
    "yargs": "^17.7.2"
  },
  "scripts": {
    "start": "terriajs-server --config-file serverconfig.json",
    "start:production": "node scripts/start-preview-server.cjs",
    "set-version": "node scripts/set-version.cjs",
    "gulp": "gulp",
    "build": "gulp build",
    "build:production": "gulp release",
    "dev": "gulp dev",
    "postinstall": "echo 'Installation successful. What to do next:\\n  yarn gulp dev   # Starts the server on port 3001, builds the app and dependencies, and rebuilds if files change.'",
    "prettier": "prettier --write .",
    "prettier-check": "prettier --check .",
    "lint": "gulp lint",
    "test": "node --test test/adapter/*.test.cjs test/characterization/*.test.cjs test/deployment/*.test.cjs test/foundation/*.test.cjs test/lifecycle/*.test.cjs test/server/*.test.cjs",
    "test:adapter": "node --test test/adapter/*.test.cjs",
    "test:characterization": "node --test test/characterization/*.test.cjs",
    "test:deployment": "node --test test/deployment/*.test.cjs test/server/*.test.cjs",
    "test:e2e": "playwright test",
    "test:e2e:real-client": "node test/e2e/real-client-smoke.cjs",
    "test:foundation": "node --test test/foundation/*.test.cjs",
    "test:lifecycle": "node --test test/lifecycle/*.test.cjs",
    "helm-docs": "docker run --rm -v \"$(pwd):/helm-docs\" -u $(id -u) jnorwood/helm-docs:v1.11.0 -t ./README.md.gotmpl -o ../../../README.md",
    "update-all-charts": "helm dep up ./deploy/helm/magda-preview-map",
    "add-all-chart-version-changes": "git ls-files -m | grep Chart.yaml | xargs git add && git ls-files -m | grep Chart.lock | xargs git add",
    "add-all-helm-docs-changes": "yarn helm-docs && git ls-files -m | grep -i readme.md | xargs git add",
    "helm-lint": "helm lint deploy/helm/magda-preview-map -f deploy/helm/test-deploy.yaml"
  },
  "magda": {
    "language": "javascript",
    "categories": {
      "map": true
    }
  },
  "versionUpdateExclude": [
    "terria",
    "terriamap"
  ]
}
